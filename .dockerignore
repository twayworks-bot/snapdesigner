# ==============================================================================
# Design & Layout Studio (v5.0 IA) — Docker Ignore Rules (.dockerignore)
# Prevents sensitive credentials, personal data, caches, VCS history, and
# unnecessary development files from entering the Docker build context/image.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Version Control & GitHub Sync Scripts (버전 관리 및 동기화 스크립트)
# ------------------------------------------------------------------------------
.git/
.gitignore
.gitattributes
.gitmodules
.github/
.gitlab/
syncgithub.py
syncgithub.env

# ------------------------------------------------------------------------------
# 2. Environments, Secrets, Credentials & Personal Data (환경변수, 개인정보, 민감데이터)
# ------------------------------------------------------------------------------
.env
*.env
.env.*
.env*.local
*.local.env
.env.example
app.env.example

# 가상환경 디렉토리
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/

# 보안 인증서, 비밀키, SSH 키, API 키, 토큰 및 자격증명 파일
*token*
*.token
token.txt
tokens.json
*secret*
*.secret
secrets.json
*credential*
credentials.json
client_secret*.json
service_account*.json
*apikey*
*api_key*
*password*
*passwd*
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.pub
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts
.netrc
.npmrc
.pypirc
.aws/
.ssh/
.gnupg/

# 개인정보(PII) 및 민감 데이터 파일 패턴
*personal*
*private*
*sensitive*
*.pii
*.Dump
*.dmp

# ------------------------------------------------------------------------------
# 3. Python Bytecode, Test & Linter Caches (Python 캐시 및 테스트 산출물)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
nosetests.xml
htmlcov/
cover/
*.cover
*.py,cover
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/
.eslintcache
.stylelintcache
.parcel-cache/
node_modules/

# ------------------------------------------------------------------------------
# 4. Distribution, Packaging & Archives (빌드 산출물 및 압축 파일)
# ------------------------------------------------------------------------------
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ------------------------------------------------------------------------------
# 5. Local Databases, Backups & Temporary Storage (로컬 DB, 백업 및 임시 폴더)
# ------------------------------------------------------------------------------
seed_data/
storage/
downloads/
uploads/
backups/
backup/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite3-journal
*.sqlite-wal
*.sqlite-shm
*.sql
*.dump
local_settings.py
db.sqlite3
db.sqlite3-journal

# Dockerfile에서 COPY data /app/data로 초기 시드 JSON 3종을 복사하므로 백업/임시 파일만 차단
data/*.bak
data/*.tmp
data/*_backup.json
data/*_local.json
!data/styles_metadata.json
!data/layouts_metadata.json
!data/twayworks_profile.json

# ------------------------------------------------------------------------------
# 6. Temporary Files, Logs, Notes & Shell Histories (임시 파일, 로그, 개발 노트)
# ------------------------------------------------------------------------------
notes/
*.log
logs/
log/
scratch/
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*~
*.swp
*.swo
*.swn
*.pid
*.seed
*.pid.lock
.bash_history
.zsh_history
.python_history
.node_repl_history
.lesshst
.history
.history/

# Docker 관련 설정 파일 자체는 이미지 내부에 불필요 (단, README.md는 COPY 대상이므로 유지)
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
.dockerignore
!README.md

# ------------------------------------------------------------------------------
# 7. IDE, Editor, AI Agents & OS Metadata (에디터, AI 도구 캐시 및 OS 메타데이터)
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
.gemini/
.cursor/
.windsurf/
.aider*
.claude/
.copilot/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk
.ipynb_checkpoints/
profile_default/
ipython_config.py
